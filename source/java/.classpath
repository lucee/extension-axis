<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry including="**/*.java" kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="libs/org.apache.commons.discovery-0.5.jar"/>
	<classpathentry kind="lib" path="libs/org.lucee.jaxrpc-1.4.0.jar"/>
	<classpathentry kind="lib" path="libs/org.lucee.saaj-1.4.0.jar"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-1.8">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="libs/org.lucee.wsdl4j-1.5.1.00002L.jar"/>
	<classpathentry kind="lib" path="libs/org.lucee.commons.httpclient-3.1.0.0002L.jar"/>
	<classpathentry kind="lib" path="libs/org.lucee.axis.ant-1.4.0.0006L.jar"/>
	<classpathentry kind="lib" path="libs/org.lucee.axis-1.4.0.0006L.jar"/>
	<classpathentry kind="lib" path="libs/org.apache.commons.net-3.3.0.jar"/>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="libs/jakarta.jakartaee-api-10.0.0.jar"/>
	<classpathentry kind="lib" path="libs/lucee.jar"/>
	<classpathentry kind="lib" path="libs/javax.servlet-api-3.0.1.jar"/>
	<classpathentry kind="lib" path="libs/org.lucee.commons.logging-1.2.0.0000L.jar"/>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
